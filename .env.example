# Google Cloud project with billing and Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Parallel track. Create this in the Parallel platform; never commit the real key.
PARALLEL_API_KEY=your-parallel-api-key
PARALLEL_SECRET_ID=parallel-api-key

# Google ADK uses Vertex AI rather than a non-Google model provider.
GOOGLE_GENAI_USE_VERTEXAI=true
AGENT_STAGING_BUCKET=gs://infinite-cinema-agent-staging-project-number
AGENT_ENGINE_ID=your-reasoning-engine-id

# Current stable Veo 3.1 image-to-video model. Override if your project uses another model.
VEO_MODEL=veo-3.1-generate-001
VEO_DURATION_SECONDS=6
VEO_RESOLUTION=720p
VEO_ASPECT_RATIO=16:9

# Optional. If set, Veo writes output to this Cloud Storage prefix.
# VEO_OUTPUT_GCS_URI=gs://your-bucket/infinite-cinema/shot-01/

SHOT_1_IMAGE=assets/shot-01-reference.png
SHOT_1_OUTPUT=outputs/shot-01.mp4
